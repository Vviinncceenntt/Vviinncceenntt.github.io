# Quieter installs:
# - Hide funding / audit summaries (Expo pins versions, so audit-fix would
#   break the dependency tree).
# - Hide deprecation warnings from transitive packages (we already pin the
#   modern replacements via "overrides" in package.json; npm still walks
#   the original lock entries during resolution and prints the warnings).
fund=false
audit=false
loglevel=error
# Required by some legacy peer dependencies during the upgrade window.
# Remove once every transitive plugin lists a stable peer range.
legacy-peer-deps=true
# Stop npx from silently fetching the latest "expo" tag from the
# registry when the local install is missing. Without this, on a fresh
# clone "npx expo start" silently downloads expo@latest (which is
# currently SDK 56) and the Expo Go on the iPhone (pinned to SDK 54)
# refuses to load the bundle.
prefer-offline=true
