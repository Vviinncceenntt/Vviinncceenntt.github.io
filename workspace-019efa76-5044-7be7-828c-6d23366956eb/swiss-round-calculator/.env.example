# Copy to .env and fill in real values. .env is gitignored.

# RevenueCat public SDK keys (safe to ship; do NOT use secret API keys here)
REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat entitlement & offering identifiers (must match RC dashboard)
REVENUECAT_ENTITLEMENT_ID=swiss_round_calculator_pro
REVENUECAT_OFFERING_ID=default
REVENUECAT_ANNUAL_PACKAGE_ID=$rc_annual

# Base price (display fallback only; actual localised price always comes from RC)
BASE_PRICE_AMOUNT=30
BASE_PRICE_CURRENCY=HKD

# Bundle / package identifiers
IOS_BUNDLE_ID=com.vviinncceenntt.swissroundcalculator
ANDROID_PACKAGE=com.vviinncceenntt.swissroundcalculator

# EAS
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
